# .env de Immich SIN la contraseña de la base de datos (RBK 15 v3, paso 4).
# DB_PASSWORD la añade el usuario en el NAS desde el gestor de contraseñas (paso 5); nunca en el repo.
UPLOAD_LOCATION=/srv/immich/data
DB_DATA_LOCATION=/srv/immich/postgres
TZ=Indian/Reunion
IMMICH_VERSION=v3.3.5
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
